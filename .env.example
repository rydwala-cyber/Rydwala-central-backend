# Rydwala Central Backend Environment Configuration

# Server
PORT=3000
NODE_ENV=development
DEMO_MODE=false

# Security & Authentication
JWT_SECRET=rydwala_production_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
# When DATABASE_URL or PG* variables are provided, Central Backend connects to PostgreSQL.
# In development/preview without external DB, the backend automatically uses its resilient in-memory storage.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rydwala_db
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=rydwala_db
PGPORT=5432

# UPI & Payment Gateway
UPI_MERCHANT_ID=rydwala@icici
UPI_MERCHANT_NAME=Rydwala Mobility Pvt Ltd
PAYMENT_WEBHOOK_SECRET=rydwala_whsec_prod_9981

# AI Studio App URL
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
